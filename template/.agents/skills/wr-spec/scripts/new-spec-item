#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import re
import sys
from dataclasses import dataclass
from datetime import datetime
from pathlib import Path
from zoneinfo import ZoneInfo, ZoneInfoNotFoundError


LIFECYCLE_FILES = {
    "spec": "spec.md",
    "plan": "plan.md",
    "verification": "verification.md",
    "review": "review.md",
}


@dataclass
class SpecContext:
    repo_root: Path
    artifact_root: Path
    spec_id: str
    title: str
    slug: str
    created_at: str
    timezone: str
    spec_dir: Path
    files: dict[str, Path]


class CreationError(Exception):
    def __init__(self, code: str, message: str, exit_code: int = 1):
        super().__init__(message)
        self.code = code
        self.message = message
        self.exit_code = exit_code


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="new-spec-item",
        description="Create a new wayrail spec item directory.",
    )
    parser.add_argument("--json", action="store_true", help="Print one machine-readable JSON object")
    parser.add_argument("--dry-run", action="store_true", help="Report actions without writing files")
    parser.add_argument("--slug", help="Short lower-case slug to use in the spec id")
    parser.add_argument("--root", default=".", help="Target repository root")
    parser.add_argument("--timezone", default=None, help="IANA timezone name, such as Asia/Seoul")
    parser.add_argument("title", nargs="+", help="Spec title")
    return parser


def read_text(path: Path) -> str:
    try:
        return path.read_text()
    except OSError as error:
        raise CreationError("template_unreadable", f"Template could not be read: {path}: {error}") from error
    except UnicodeDecodeError as error:
        raise CreationError("template_unreadable", f"Template is not valid UTF-8: {path}: {error}") from error


def load_artifact_root(repo_root: Path) -> str:
    config_path = repo_root / "wayrail.yaml"
    if not config_path.exists():
        return "specs"

    try:
        for line in config_path.read_text().splitlines():
            stripped = line.strip()
            if stripped.startswith("artifact_root:"):
                value = stripped.split(":", 1)[1].strip().strip("'\"")
                return value or "specs"
    except OSError as error:
        raise CreationError("config_unreadable", f"wayrail.yaml could not be read: {error}", 2) from error
    except UnicodeDecodeError as error:
        raise CreationError("config_unreadable", f"wayrail.yaml is not valid UTF-8: {error}", 2) from error

    return "specs"


def normalize_slug(raw_slug: str) -> str:
    slug = raw_slug.strip().lower()
    slug = re.sub(r"[^a-z0-9]+", "-", slug)
    slug = re.sub(r"-{2,}", "-", slug).strip("-")
    return slug


def validate_slug(slug: str) -> str:
    normalized = normalize_slug(slug)
    if not normalized:
        raise CreationError("invalid_slug", "Slug must contain at least one letter or number")
    if normalized != slug:
        raise CreationError("invalid_slug", "Slug must be lower-case letters, numbers, and hyphens")
    return normalized


def title_to_slug(title: str) -> str:
    words = normalize_slug(title).split("-")
    slug = "-".join(word for word in words if word)[:48].strip("-")
    if not slug:
        raise CreationError("invalid_title", "Title must contain at least one letter or number")
    return slug


def resolve_timezone(raw_timezone: str | None):
    timezone = raw_timezone or "local"
    if timezone == "local":
        local_now = datetime.now().astimezone()
        return "local", local_now.tzinfo
    try:
        return timezone, ZoneInfo(timezone)
    except ZoneInfoNotFoundError as error:
        raise CreationError("invalid_timezone", f"Invalid timezone: {timezone}") from error


def ensure_safe_relative_path(path: str, code: str) -> Path:
    relative = Path(path)
    if relative.is_absolute() or ".." in relative.parts:
        raise CreationError(code, f"Unsafe relative path: {path}")
    return relative


def build_context(args: argparse.Namespace) -> SpecContext:
    title = " ".join(args.title).strip()
    if not title:
        raise CreationError("missing_title", "Title is required", 2)

    repo_root = Path(args.root).expanduser().resolve()
    if repo_root.exists() and not repo_root.is_dir():
        raise CreationError("invalid_root", f"Root is not a directory: {repo_root}", 2)

    artifact_root_name = load_artifact_root(repo_root)
    artifact_relative = ensure_safe_relative_path(artifact_root_name, "invalid_artifact_root")
    artifact_root = repo_root / artifact_relative

    timezone_name, tzinfo = resolve_timezone(args.timezone)
    now = datetime.now(tzinfo)
    created_at = now.strftime("%Y-%m-%d %H:%M")
    timestamp = now.strftime("%Y%m%d-%H%M")

    slug = validate_slug(args.slug) if args.slug else title_to_slug(title)
    spec_id = f"{timestamp}-{slug}"
    spec_dir = artifact_root / spec_id
    files = {name: spec_dir / filename for name, filename in LIFECYCLE_FILES.items()}

    return SpecContext(
        repo_root=repo_root,
        artifact_root=artifact_root,
        spec_id=spec_id,
        title=title,
        slug=slug,
        created_at=created_at,
        timezone=timezone_name,
        spec_dir=spec_dir,
        files=files,
    )


def relative_to_repo(context: SpecContext, path: Path) -> str:
    return path.relative_to(context.repo_root).as_posix()


def template_path(context: SpecContext, name: str) -> Path:
    return context.artifact_root / "_templates" / LIFECYCLE_FILES[name]


def check_preconditions(context: SpecContext) -> list[dict[str, str]]:
    conflicts: list[dict[str, str]] = []

    if context.spec_dir.exists():
        conflicts.append(
            {
                "path": relative_to_repo(context, context.spec_dir),
                "reason": "spec directory already exists",
            }
        )

    current = context.repo_root
    for part in context.spec_dir.relative_to(context.repo_root).parts[:-1]:
        current = current / part
        if current.is_symlink():
            conflicts.append({"path": relative_to_repo(context, current), "reason": "parent path is a symlink"})
        elif current.exists() and not current.is_dir():
            conflicts.append(
                {
                    "path": relative_to_repo(context, current),
                    "reason": "parent path exists and is not a directory",
                }
            )

    for name, path in context.files.items():
        if path.exists():
            conflicts.append({"path": relative_to_repo(context, path), "reason": f"{name} file already exists"})

    for name in LIFECYCLE_FILES:
        path = template_path(context, name)
        if not path.exists():
            conflicts.append({"path": relative_to_repo(context, path), "reason": "required template is missing"})
        elif not path.is_file():
            conflicts.append({"path": relative_to_repo(context, path), "reason": "required template is not a file"})

    return conflicts


def render_template(text: str, context: SpecContext, name: str) -> str:
    replacements = {
        "<YYYYMMDD-HHMM-short-slug>": context.spec_id,
        "<Title>": context.title,
        "<YYYY-MM-DD HH:MM>": context.created_at,
        "<Timezone>": context.timezone,
    }
    for marker, value in replacements.items():
        text = text.replace(marker, value)
    if name == "spec":
        text = text.replace("status: draft", "status: active", 1)
    return text


def validate_generated_spec(text: str) -> None:
    required = ["spec_id:", "title:", "status:", "stage:", "created_at:", "timezone:"]
    missing = [field for field in required if field not in text]
    if missing:
        raise CreationError("generated_spec_invalid", f"Generated spec.md is missing frontmatter fields: {', '.join(missing)}")


def planned_actions(context: SpecContext, dry_run: bool) -> list[dict[str, object]]:
    return [
        {
            "path": relative_to_repo(context, path),
            "action": "create",
            "applied": not dry_run,
            "source": "repo-template",
        }
        for path in context.files.values()
    ]


def payload(
    context: SpecContext,
    *,
    status: str,
    dry_run: bool,
    safe_to_apply: bool,
    actions: list[dict[str, object]],
    conflicts: list[dict[str, str]],
    error: dict[str, str] | None,
    next_action: str,
) -> dict[str, object]:
    created_paths = [] if dry_run or status != "created" else [relative_to_repo(context, path) for path in context.files.values()]
    planned_paths = [relative_to_repo(context, path) for path in context.files.values()] if dry_run and safe_to_apply else []
    return {
        "schema_version": 1,
        "command": "new-spec-item",
        "status": status,
        "dry_run": dry_run,
        "safe_to_apply": safe_to_apply,
        "repo_root": str(context.repo_root),
        "spec": {
            "spec_id": context.spec_id,
            "title": context.title,
            "slug": context.slug,
            "created_at": context.created_at,
            "timezone": context.timezone,
            "spec_dir": str(context.spec_dir),
            "files": {name: str(path) for name, path in context.files.items()},
        },
        "created_paths": created_paths,
        "planned_paths": planned_paths,
        "actions": actions,
        "conflicts": conflicts,
        "error": error,
        "next_action": next_action,
    }


def error_payload(
    *,
    context: SpecContext | None,
    dry_run: bool,
    code: str,
    message: str,
    exit_code: int,
) -> dict[str, object]:
    base_spec: dict[str, object] | None = None
    repo_root = ""
    if context is not None:
        repo_root = str(context.repo_root)
        base_spec = {
            "spec_id": context.spec_id,
            "title": context.title,
            "slug": context.slug,
            "created_at": context.created_at,
            "timezone": context.timezone,
            "spec_dir": str(context.spec_dir),
            "files": {name: str(path) for name, path in context.files.items()},
        }

    return {
        "schema_version": 1,
        "command": "new-spec-item",
        "status": "error" if exit_code == 2 else "conflict",
        "dry_run": dry_run,
        "safe_to_apply": False,
        "repo_root": repo_root,
        "spec": base_spec,
        "created_paths": [],
        "planned_paths": [],
        "actions": [],
        "conflicts": [] if context is None else [{"path": relative_to_repo(context, context.spec_dir), "reason": message}],
        "error": {"code": code, "message": message},
        "next_action": "fix_invocation" if exit_code == 2 else "resolve_conflicts",
    }


def print_result(data: dict[str, object], json_mode: bool) -> None:
    if json_mode:
        print(json.dumps(data, indent=2, sort_keys=True))
        return

    print(f"new-spec-item: {data['status']}")
    print(f"spec_id: {data['spec']['spec_id']}")  # type: ignore[index]
    print(f"spec_dir: {data['spec']['spec_dir']}")  # type: ignore[index]
    if data["conflicts"]:
        for conflict in data["conflicts"]:  # type: ignore[union-attr]
            print(f"- conflict: {conflict['path']} ({conflict['reason']})")  # type: ignore[index]


def render_files(context: SpecContext) -> dict[str, str]:
    rendered: dict[str, str] = {}
    for name in LIFECYCLE_FILES:
        text = render_template(read_text(template_path(context, name)), context, name)
        if name == "spec":
            validate_generated_spec(text)
        rendered[name] = text
    return rendered


def write_files(context: SpecContext, rendered: dict[str, str]) -> None:
    context.spec_dir.mkdir(parents=True, exist_ok=False)
    for name, path in context.files.items():
        path.write_text(rendered[name])


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    raw_argv = argv if argv is not None else sys.argv[1:]
    json_requested = "--json" in raw_argv
    context: SpecContext | None = None

    try:
        args = parser.parse_args(argv)
    except SystemExit as error:
        exit_code = int(error.code) if isinstance(error.code, int) else 2
        if json_requested:
            data = error_payload(
                context=None,
                dry_run="--dry-run" in raw_argv,
                code="invalid_invocation",
                message="Invalid invocation",
                exit_code=exit_code,
            )
            print_result(data, True)
            return exit_code
        raise

    try:
        context = build_context(args)
        conflicts = check_preconditions(context)
        if conflicts:
            actions = [
                {
                    "path": conflict["path"],
                    "action": "conflict",
                    "applied": False,
                    "reason": conflict["reason"],
                }
                for conflict in conflicts
            ]
            data = payload(
                context,
                status="conflict",
                dry_run=args.dry_run,
                safe_to_apply=False,
                actions=actions,
                conflicts=conflicts,
                error={"code": "preflight_failed", "message": "Spec item cannot be created safely"},
                next_action="resolve_conflicts",
            )
            print_result(data, args.json)
            return 1

        actions = planned_actions(context, args.dry_run)
        rendered = render_files(context)
        if not args.dry_run:
            write_files(context, rendered)

        data = payload(
            context,
            status="planned" if args.dry_run else "created",
            dry_run=args.dry_run,
            safe_to_apply=True,
            actions=actions,
            conflicts=[],
            error=None,
            next_action="write_spec",
        )
        print_result(data, args.json)
        return 0
    except CreationError as error:
        if args.json:
            data = error_payload(
                context=context,
                dry_run=args.dry_run,
                code=error.code,
                message=error.message,
                exit_code=error.exit_code,
            )
            print_result(data, True)
        print(error.message, file=sys.stderr)
        return error.exit_code


if __name__ == "__main__":
    raise SystemExit(main())
