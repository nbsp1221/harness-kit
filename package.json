{
  "name": "@retn0/wayrail",
  "version": "0.1.0",
  "description": "retn0's opinionated wayrail starter for repo-local agent workflows.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nbsp1221/wayrail.git"
  },
  "bin": {
    "wayrail": "./bin/wayrail.js",
    "wyr": "./bin/wayrail.js"
  },
  "files": [
    "bin/",
    "template/README.md",
    "template/AGENTS.md",
    "template/wayrail.yaml",
    "template/docs/roadmap/README.md",
    "template/specs/.gitkeep",
    "template/specs/_templates/spec.md",
    "template/specs/_templates/plan.md",
    "template/specs/_templates/verification.md",
    "template/specs/_templates/review.md",
    "template/.agents/skills/wr-spec/SKILL.md",
    "template/.agents/skills/wr-spec/scripts/new-spec-item",
    "template/.agents/skills/wr-spec/agents/openai.yaml",
    "template/.agents/skills/wr-plan/SKILL.md",
    "template/.agents/skills/wr-plan/agents/openai.yaml",
    "template/.agents/skills/wr-verify/SKILL.md",
    "template/.agents/skills/wr-verify/agents/openai.yaml",
    "template/.agents/skills/wr-review/SKILL.md",
    "template/.agents/skills/wr-review/agents/openai.yaml",
    "template/memory/learnings.md",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "python -m unittest discover -s tests",
    "package:dry-run": "npm pack --dry-run --json",
    "package:check": "python -m unittest discover -s tests && npm pack --dry-run --json"
  }
}
